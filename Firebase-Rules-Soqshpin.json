{
  "rules": {
    "drivers": {
      ".read": true,
      ".write": true,
      ".indexOn": ["status", "vehicle", "online"]
    },
    "clients": {
      ".read": true,
      ".write": true,
      ".indexOn": ["phone"]
    },
    "clients_by_phone": {
      ".read": true,
      ".write": true
    },
    "rides": {
      ".read": true,
      ".write": true,
      ".indexOn": ["status", "clientId", "driverId"]
    },
    "pending_rides": {
      ".read": true,
      ".write": true,
      ".indexOn": ["vehicleType", "status"]
    },
    "live_locations": {
      ".read": true,
      ".write": true,
      ".indexOn": ["vehicle", "time"]
    },
    "ride_offers": {
      ".read": true,
      ".write": true
    },
    "direct_requests": {
      ".read": true,
      ".write": true
    },
    "history": {
      ".read": true,
      ".write": true
    },
    "ratings": {
      ".read": true,
      ".write": true
    },
    "blocked_phones": {
      ".read": true,
      ".write": true
    }
  }
}
